{
  "info": {
    "_postman_id": "wallet-payment-service-v1",
    "name": "Wallet & Payment Service",
    "description": "Complete API collection for Wallet & Payment Management System\n\n**Base URL:** `http://localhost:8080/api`\n\n**Total Endpoints:** 29\n\n**Modules:**\n- Wallet Account (5)\n- Wallet Ledger Entry (5)\n- Wallet Ledger Entry Fee (3)\n- Payment (5)\n- Payment Transaction (5)\n- Payment Transaction Fee (3)\n- Order Payment Allocation (3)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Wallet Account",
      "item": [
        {
          "name": "WA-01: Create Wallet Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Save walletAccountId for later tests",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set(\"walletAccountId\", response.id);",
                  "    pm.environment.set(\"customerId\", response.customerId);",
                  "}",
                  "",
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has wallet account data\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.status).to.eql('ACTIVE');",
                  "    pm.expect(jsonData.currentBalance).to.eql(0.00);",
                  "    pm.expect(jsonData.currencyCode).to.eql('TRY');",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 500ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 12345,\n  \"currencyCode\": \"TRY\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/wallet-accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallet-accounts"
              ]
            },
            "description": "Müşteri için yeni bir cüzdan hesabı oluşturur. Varsayılan olarak ACTIVE durumda ve 0 bakiye ile başlar."
          },
          "response": []
        },
        {
          "name": "WA-02: Get Wallet Accounts by Customer (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has pagination data\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('content');",
                  "    pm.expect(jsonData).to.have.property('totalElements');",
                  "    pm.expect(jsonData).to.have.property('pageNumber');",
                  "    pm.expect(jsonData).to.have.property('pageSize');",
                  "    pm.expect(jsonData).to.have.property('totalPages');",
                  "});",
                  "",
                  "pm.test(\"Content is an array\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.content).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallet-accounts/customer/{{customerId}}?page=0&size=20&sort=createdAt,desc",
              "host": [
                "{{baseUrl}}"
